# ==========================================================================
# Honor 10 · 抓包解析 / Checkin Provider 项目
# ==========================================================================

# --------------------------------------------------------------------------
# 1. 密钥与凭证（严禁提交）
# --------------------------------------------------------------------------
# MCP 配置内含 SSH 主机/密码
.mcp.json
# Cloudflare API Token 说明与明文
cloudflaretoken
cloudflaretoken.txt
*.token
*.pem
*.key

# 通用环境变量
.env
.env.*
!.env.example

# --------------------------------------------------------------------------
# 2. 抓包原始文件（体积大，可由 Fiddler/Charles 重新导出）
# --------------------------------------------------------------------------
examples/**/*.saz
*.saz

# --------------------------------------------------------------------------
# 3. 抓包解析结果中的静态资源响应体
#    （前端 bundle / 图片 / 字体，非接口证据，占 examples 体积 >70%）
# --------------------------------------------------------------------------
examples/**/响应体.js
examples/**/响应体.css
examples/**/响应体.js.map
examples/**/响应体.png
examples/**/响应体.jpg
examples/**/响应体.jpeg
examples/**/响应体.gif
examples/**/响应体.apng
examples/**/响应体.webp
examples/**/响应体.ico
examples/**/响应体.svg
examples/**/响应体.ttf
examples/**/响应体.woff
examples/**/响应体.woff2
examples/**/响应体.eot
examples/**/响应体.wasm
examples/**/响应体.bin
examples/**/响应体.srf
examples/**/响应体.mp4
examples/**/响应体.zip
examples/**/响应体.xml

# 大模型对话请求体（含私人对话内容，单文件 8MB+）
examples/**/*mimo-server-cn.xiaomimimo.com*/请求体.json
# 无扩展名的原始响应体（通常为未知 content-type 的大块数据）
examples/**/响应体

# --------------------------------------------------------------------------
# 4. 部署 / 运行时产物
# --------------------------------------------------------------------------
.wrangler/
monitor/.wrangler/
monitor/deploy_tmp/
monitor/probe_tmp.mjs
_test_usage_stats.mjs
log
*.log
*.pid

# --------------------------------------------------------------------------
# 5. 依赖与构建
# --------------------------------------------------------------------------
node_modules/
dist/
build/
out/
.cache/
coverage/
__pycache__/
*.py[cod]
.venv/
venv/

# --------------------------------------------------------------------------
# 6. 编辑器 / 系统
# --------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
~$*

# --------------------------------------------------------------------------
# 7. 作业/临时文件（由脚本生成，可重建）
# --------------------------------------------------------------------------
*.tmp
*.bak
*_tmp/
