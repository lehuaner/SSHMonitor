1000
 var DAY_MS = 86400000;\n  var BEIJING_OFFSET_MS = 8 * 3600000;\n  var MIDNIGHT_GUARD_MS = 1000;      // 对齐到北京时间 00:00:01，给服务端留 1 秒缓冲\n  var RETRY_DELAY_MS = 10 * 1000;    // 失败后每 10 秒重试一次\n  var MAX_RETRY = 3;\n\n  // Date.now() 是 UTC 时间戳，与用户本机时区无关；+8 小时取整得到北京时间的天序号\n  function getBeijingDay() {\n    return Math.floor((Date.now() + BEIJING_OFFSET_MS) / DAY_MS);\n  }\n\n  // 计算距离\"下一个北京时间 00:00:01\"还差多少毫秒（一次性定点唤醒，不轮询）\n  function getDelayToNextMidnight() {\n    var nowInBeijing = Date.now() + BEIJING_OFFSET_MS;\n    var nextDayStart = (Math.floor(nowInBeijing / DAY_MS) + 1) * DAY_MS;\n    var delay = nextDayStart + MIDNIGHT_GUARD_MS - nowInBeijing;\n    return delay \u003e 0 ? delay : MIDNIGHT_GUARD_MS;\n  }\n\n  var cachedDay = getBeijingDay();\n  var retryCount = 0;\n  var midnightTimer = null;\n\n  function requestRefresh() {\n    if (!station || !station.isConnected) return;\n    bridge.emit('refresh_checkin_status');\n  }\n\n  function scheduleMidnightRefresh() {\n    if (midnightTimer) {\n      clearTimeout(midnightTimer);\n    }\n    midnightTimer = setTimeout(function() {\n      midnightTimer = null;\n      if (!station || !station.isConnected) return;\n      // 到点后仍确认一次是否真的隔天：防系统时钟被调整 / 休眠唤醒提前触发导致空请求\n      if (getBeijingDay() !== cachedDay) {\n        retryCount = 0;\n        requestRefresh();\n      }\n      // 无论本次是否触发刷新，都重新对准下一个零点\n      scheduleMidnightRefresh();\n    }, getDelayToNextMidnight());\n  }\n\n  function setView(view) {\n    station.setAttribute('data-view', view === 'expanded' ? 'expanded' : 'compact');\n  }\n\n  function getLabels() {\n    if (isEnglishLocale()) {\n      return {\n        compactPrefix: 'Daily',\n        compactUnit: 'Pts',\n        caption: 'Points available daily',\n        claimed: 'Claimed',\n        days: 'Days',\n        total: 'Total',\n        totalUnit: 'Pts',\n        claimedButton: 'Claimed',\n        loading: 'Claiming...',\n        claimButton: data.btn || '立即领取' || 'Claim Now',\n      };\n    }\n    return {