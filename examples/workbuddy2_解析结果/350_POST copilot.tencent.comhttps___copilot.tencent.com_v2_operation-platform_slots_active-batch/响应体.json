=\"var(--bubble-tail-color)\"\u003e\u003c/path\u003e\n    \u003c/svg\u003e\n  \u003c/div\u003e\n\u003c/div\u003e\n\n\u003cscript\u003e\n  (function() {\n    var root = window.__SHADOW_ROOT__ || document;\n    var bridge = (typeof __HOST_BRIDGE__ !== 'undefined' \u0026\u0026 __HOST_BRIDGE__) || window.__HOST_BRIDGE__;\n    var bubble = root.querySelector('.activity-bubble');\n    var data = {\n      btn: bubble ? bubble.getAttribute('data-btn') || '' : '',\n      level: bubble ? bubble.getAttribute('data-level') || '' : ''\n    };\n\n    var LEVEL_TEXT = {\n      activity: { zh: '活动', en: 'Events' },\n      notification: { zh: '通知', en: 'Notice' }\n    };\n\n    function applyLocale(locale) {\n      var lang = (locale || 'zh-cn').indexOf('zh') === 0 ? 'zh' : 'en';\n      root.querySelectorAll('[data-i18n-zh]').forEach(function(el) {\n        var text = el.getAttribute('data-i18n-' + lang) || el.getAttribute('data-i18n-zh');\n        if (text) {\n          el.textContent = text;\n        }\n      });\n    }\n\n    function setupTitle() {\n      var titleEl = root.getElementById('activity-bubble-title');\n      if (!titleEl) return;\n\n      var level = String(data.level || 'activity').trim();\n      var texts = LEVEL_TEXT[level] || LEVEL_TEXT.activity;\n      titleEl.setAttribute('data-i18n-zh', texts.zh);\n      titleEl.setAttribute('data-i18n-en', texts.en);\n      titleEl.textContent = texts.zh;\n    }\n\n    function setupCloseButton() {\n      var closeButton = root.querySelector('.activity-bubble__close');\n      if (!closeButton || !bridge || typeof bridge.close !== 'function') {\n        return;\n      }\n\n      closeButton.addEventListener('click', function() {\n        bridge.close();\n      });\n    }\n\n    function setupActionButton() {\n      var footer = root.getElementById('activity-bubble-footer');\n      var button = root.getElementById('activity-bubble-btn');\n      var buttonText = String(data.btn || '').trim();\n\n      if (!footer || !button) {\n        return;\n      }\n\n      if (!buttonText) {\n        footer.classList.add('is-hidden');\n        return;\n      }\n\n      button.textContent = buttonText;\n      button.addEventListener('click', function() {\n        if (bridge \u0026\u0026 typeof bridge.triggerAction === 'function') {\n          bridge.triggerAction();\n        }\n      });\n    }\n\n    setupTitle();\n    applyLocale('zh-cn');\n    setupCloseButton();\n    setupActionButton();\n\n    if (bridge \u0026\u0026 typeof bridge.on === 'function') {\n      bridge.on('locale_changed', function(payload) {\n        applyLocale(payload \u0026\u0026 payload.locale);\n      });\n    }\n  })();\n\u003c/script\u003e","jumpUrl":"https://www.workbuddy.cn/events/campus-freshman/","level":"activity"},"call_interval_sec":300},"home_growth":{"id":"2079419563210231808","slot_key":"home_growth","start_at":1784563200000,"end_at":1830268799000,"extra":{"body":"做任务赢积分好礼","btnAction":"jump","html":"\u003cstyle\u003e\n  /* ========== 主题 Token（亮色默认 / 暗色覆盖） ========== */\n  :host {\n    --capsule-bg: #FFFFFF;\n    --capsule-border: rgba(0, 0, 0, 0.12);\n    --capsule-shadow: 0 6px 24px -4px rgba(0, 0, 0, 0.04), 0 4px 6px -2px rgba(0, 0, 0, 0.06);\n    --capsule-text: rgba(0, 0, 0, 0.85);\n    --capsule-chevron: rgba(0, 0, 0, 0.45);\n    --capsule-icon-line: #000000;\n    --capsule-icon-check: #00C29A;\n  }\n  :host([data-theme=\"dark\"]) {\n    --capsule-bg: rgba(255, 255, 255, 0.08);\n    --capsule-border: rgba(255, 255, 255, 0.12);\n    --capsule-shadow: 0 6px 24px rgba(0, 0, 0, 0.2);\n    --capsule-text: rgba(255, 255, 255, 0.85);\n    --capsule-chevron: rgba(255, 255, 255, 0.45);\n    --capsule-icon-line: #FFFFFF;\n    --capsule-icon-check: #00C29A;\n  }\n\n  /* ========== 外层容器（定位参考） ========== */\n  .growth-capsule-wrapper {\n    position: relative;\n    di
