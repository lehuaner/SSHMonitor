0\n      || actionText.indexOf('explore') \u003e= 0\n      || actionText.indexOf('try') \u003e= 0;\n  }\n\n  function formatSeasonTitle(season, name) {\n    return isEnglishLocale() ? (name + ' · S' + season) : (name + '·' + season + '期');\n  }\n\n  function update(payload) {\n    if (!payload) return;\n    var credits = payload.todayCredit || payload.credit || data.dailyCredit || '100' || 150;\n    var days = payload.streakDays != null ? payload.streakDays : payload.streak_days;\n    var sum = payload.totalCredits != null ? payload.totalCredits : ((days || 0) * Number(credits || 0));\n    var season = payload.season || data.season || '8' || 2;\n    var topic = data.topic || 'Buddy加油站' || '连接ima资料库';\n    var labels = getLabels();\n    compactPrefix.textContent = labels.compactPrefix;\n    compactUnit.textContent = labels.compactUnit;\n    caption.textContent = labels.caption;\n    claimedLabel.textContent = labels.claimed;\n    daysLabel.textContent = labels.days;\n    totalLabel.textContent = labels.total;\n    totalUnit.textContent = labels.totalUnit;\n    creditCompact.textContent = credits;\n    score.textContent = credits;\n    streak.textContent = days || 0;\n    total.textContent = sum || 0;\n    titleExpanded.textContent = data.period || '开学季';\n    compactPeriod.textContent = formatSeasonTitle(season, topic);\n    period.textContent = formatSeasonTitle(season, topic);\n    if (!claiming) {\n      setLoading(false);\n    }\n    if (payload.todayCheckedIn) {\n      setClaimed();\n      return;\n    }\n    // 拿到\"未领取\"说明数据已是当天的：恢复按钮并推进缓存日期\n    setClaimable();\n    cachedDay = getBeijingDay();\n  }\n\n  function claim() {\n    if (compactClaim.disabled || expandedClaim.disabled) return;\n    claiming = true;\n    setLoading(true);\n    bridge.emit('checkin_clicked');\n  }\n\n  if (data.initialView === 'expanded') {\n    setView('expanded');\n  }\n  update(data);\n  scheduleMidnightRefresh();\n\n  root.getElementById('fuel-expand').addEventListener('click', function() { setView('expanded'); });\n  root.getElementById('fuel-close').addEventListener('click', function() { bridge.close(); });\n  root.getElementById('fuel-compact-close').addEventListener('click', function() { bridge.close(); });\n  compactClaim.addEventListener('click', claim);\n  expandedClaim.addEventListener('click', claim);\n  action.addEventListener('click', function() {\n    var url = data.jumpUrl || 'https://www.workbuddy.cn/events/campus-freshman/';\n    if (bridge \u0026\u0026 typeof bridge.triggerAction === 'function') {\n      bridge.triggerAction();\n      return;\n    }\n    if (url \u0026\u0026 bridge \u0026\u0026 typeof bridge.openLink === 'function') {\n      bridge.openLink(url);\n      return;\n    }\n    if (url \u0026\u0026 bridge \u0026\u0026 typeof bridge.emit === 'function') {\n      bridge.emit('navigate', { url: url });\n    }\n  });\n  bridge.on('checkin_status', update);\n  // 客户端代发请求的结果：未变成\"未领取\"就隔 10 秒重试，最多 MAX_RETRY 次，兼容后端短暂异常\n  bridge.on('checkin_refresh_result', function(payload) {\n    if (payload \u0026\u0026 payload.ok) {\n      retryCount = 0;\n      return;\n    }\n    if (retryCount \u003c MAX_RETRY) {\n      retryCount++;\n      setTimeout(requestRefresh, RETRY_DELAY_MS);\n      return;\n    }\n    // 重试用尽，放弃本轮并推进缓存日期，等下一个零点\n    retryCount = 0;\n    cachedDay = getBeijingDay();\n  });\n  bridge.on('checkin_result', function(payload) {\n    claiming = false;\n    setLoading(false);\n    if (payload \u0026\u0026 !payload.code) {\n      setClaimed();\n      cachedDay = getBeijingDay();\n      update(payload);\n    }\n  });\n})();\n\u003c/script\u003e","jumpUrl":"https://www.workbuddy.cn/events/campus-freshman/","period":"开学季","season":"8","topic":"Buddy加油站"},"call_interval_sec":300},"codebuddy":{"id":"2093241517907861504","slot_key":"codebuddy","start_at":1787864400000,"end_at":1789055999000,"extra":{"body":"Hy
